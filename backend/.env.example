# Copie para .env e preencha. O .env nunca vai para o repositório.
# Tudo aqui passa pelo zod em src/config/env.ts — variável errada derruba o boot,
# não um job no meio da madrugada.

# ── obrigatórias ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:senha@localhost:5432/filmes

# ── fontes externas (§5) ──────────────────────────────────────
# Sem estas, o app sobe mas os jobs correspondentes avisam e não rodam.
TMDB_API_KEY=
OMDB_API_KEY=
INGRESSO_CITY_ID=

# Parâmetro de caminho obrigatório em todo endpoint de conteúdo, NÃO documentado
# no OpenAPI, e que muda o resultado de verdade — ver
# src/modules/ingresso/CONTRATO.md §2.
#   www      = catálogo completo, todas as redes  (o que queremos)
#   ingresso = filtra para o parceiro; devolve ZERO cinemas
#   home     = mesmo resultado do padrão, mas responde em UTF-16
INGRESSO_PARTNERSHIP=www

# Lista branca de cinemas por id do ingresso, separada por virgula.
# Vazia = todos os cinemas da cidade.
INGRESSO_THEATER_IDS=

# User-Agent honesto e fixo (§5.1). Nao se passe por navegador.
# SO ASCII: acento em cabecalho HTTP faz o OMDb bloquear com 403 (medido).
INGRESSO_USER_AGENT=AppFilmes/0.1 (uso pessoal; contato pelo responsavel da instancia)

# ── canaries (§8) ─────────────────────────────────────────────
# Webhook genérico para os alertas. Vazio = só a implementação de log.
NOTIFIER_WEBHOOK_URL=

# ── matching (§7.2) ───────────────────────────────────────────
MATCH_AUTO_THRESHOLD=0.92
MATCH_REVIEW_THRESHOLD=0.75

# ── operação (acréscimos ao §16, todos com padrão sensato) ────
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

INGRESSO_BASE_URL=https://api-content.ingresso.com/v0
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
OMDB_BASE_URL=https://www.omdbapi.com

# Política de acesso do §5.1: no máximo 4 requisições simultâneas.
HTTP_MAX_CONCURRENCY=4
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_BASE_DELAY_MS=500

# A partir de quantas horas de cache o app mostra "dados de X horas atrás" (§8).
DEGRADED_AFTER_HOURS=12

# Agendador (§9). Vazio = ligado em producao, desligado em desenvolvimento.
CRON_ENABLED=

# Web Push do PWA (§3). Gere com:  npx web-push generate-vapid-keys
# A chave PUBLICA vai para o navegador; a PRIVADA nunca sai do backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ── autenticação dos dois perfis (§3, resolvido em 23/09/2026) ──
# Tela de login com seletor de perfil + senha. Sem estas variáveis o backend
# sobe em desenvolvimento (com aviso) e RECUSA subir em produção.
#
# AUTH_SECRET assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o valor desloga os dois na hora — útil se alguém perder o celular.
AUTH_SECRET=
# Uma senha por perfil. AUTH_PASSWORD serve de padrão para os dois.
AUTH_PASSWORD=
AUTH_PASSWORD_CATFLIX=
AUTH_PASSWORD_HBURSO=
# Quantos dias a sessão dura no celular.
AUTH_SESSION_DAYS=30
